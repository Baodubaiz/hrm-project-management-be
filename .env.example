# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hrm_pm_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_change_me_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_me_in_production
JWT_REFRESH_EXPIRATION=7d

# Mail / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="HRM System <no-reply@hrm.com>"

